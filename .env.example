# Supabase Configuration
# Get these from your Supabase project settings at https://supabase.com
# Project URL can be found in Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon Key (public, safe to expose) — found in Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service Role Key (secret, keep private) — found in Settings → API → Project API keys
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Bot de Instagram (webhook en /api/instagram/webhook)
# Token que inventes vos; el mismo valor se carga en Meta al configurar el webhook.
IG_VERIFY_TOKEN=un-token-largo-y-aleatorio
# App secret de la app de Meta (Configuracion de la app -> Basica). Valida la firma de los webhooks.
IG_APP_SECRET=YOUR_META_APP_SECRET
# Token de acceso de la pagina de Facebook vinculada a la cuenta de Instagram.
PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
# IA del bot: cualquier proveedor con API compatible con OpenAI. Por defecto Groq (plan gratis): https://console.groq.com
LLM_API_KEY=gsk_...
# Nombre exacto del modelo. Se ve en la consola del proveedor (en Groq: la lista de modelos y Limits).
LLM_MODEL=
# Opcional: otra API compatible. Por defecto https://api.groq.com/openai/v1
# LLM_BASE_URL=
# URL publica del sitio, para los links a las fichas que manda el bot (sin barra final).
SITE_URL=https://tu-sitio.vercel.app
# Opcional: horarios que cuenta el bot. Si no esta, deriva al WhatsApp.
# BOT_HORARIO=Lunes a Viernes 9 a 13 y 16 a 20 | Sabados 9 a 13
