# Supabase Configuration
# Get these from your Supabase project settings at https://supabase.com
# Project URL can be found in Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon Key (public, safe to expose) — found in Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service Role Key (secret, keep private) — found in Settings → API → Project API keys
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Bot de Instagram (webhook en /api/instagram/webhook)
# Token que inventes vos; el mismo valor se carga en Meta al configurar el webhook.
IG_VERIFY_TOKEN=un-token-largo-y-aleatorio
# App secret de la app de Meta (Configuracion de la app -> Basica). Valida la firma de los webhooks.
# Acepta varios secrets separados por comas (p. ej. el de Meta y el de Instagram): vale si coincide alguno.
IG_APP_SECRET=YOUR_META_APP_SECRET
# Token de acceso de la pagina de Facebook vinculada a la cuenta de Instagram.
# Con "API setup with Instagram Login" aca va el token de acceso de usuario de Instagram; esos tokens
# vencen (unos 60 dias) y hay que renovarlos.
PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
# Solo para 'API setup with Instagram Login': IG_GRAPH_BASE=https://graph.instagram.com/v21.0 (y opcionalmente IG_ID=<id de la cuenta de Instagram>)
# Sin estas variables el bot usa https://graph.facebook.com/v21.0 y "me" (Facebook Login).
# IG_GRAPH_BASE=https://graph.instagram.com/v21.0
# IG_ID=
# URL publica del sitio, para los links a las fichas que manda el bot (sin barra final).
SITE_URL=https://tu-sitio.vercel.app

# ---------------------------------------------------------------------------
# Antes de salir en vivo (checklist del bot de Instagram)
# 1. Correr en el SQL Editor de Supabase, en orden: supabase/schema-instagram.sql y despues
#    supabase/schema-instagram-reglas.sql.
# 2. APAGAR la respuesta instantanea / respuestas automaticas guardadas de Instagram y cualquier otra
#    herramienta que mande mensajes desde la cuenta: sus ecos hacen que el bot los tome por una persona
#    y se pause en cada chat nuevo.
# 3. Activar "Permitir acceso a los mensajes" en la app de Instagram (herramientas conectadas).
# 4. Suscribir el webhook al campo "messages".
# 5. SITE_URL debe ser una URL https:// (si no, las tarjetas salen sin link a la web).
# 6. Confirmar que el deploy esta en Vercel (el webhook usa maxDuration = 25).
# 7. Desactivar los registros publicos (sign-ups) en Supabase: la tabla "leads" la puede leer
#    cualquier usuario autenticado.
